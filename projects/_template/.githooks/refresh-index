#!/usr/bin/env bash
# Regenerate the gitignored arc42 index after the working tree changes.
# Never blocks a git operation: any failure (e.g. aif not installed yet) is ignored.
command -v aif >/dev/null 2>&1 || exit 0
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
(cd "$root" && aif index architecture >/dev/null 2>&1) || true
exit 0
