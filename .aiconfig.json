{
  "project_name": "ai-foundation",
  "project_shortname": "AIF",
  "standards": {
    "engineering": ["javascript", "node"],
    "all": []
  },
  "paths": {
    "plans": "docs/plans",
    "knowledge": "docs",
    "features": "docs/plans/features",
    "architecture": "docs/architecture",
    "research": "docs/research",
    "product": "docs/product"
  },
  "oversight": {
    "default": "by-size",
    "enforced": false
  },
  "ai_identity": {
    "git_author_name": "Starvoxel AI Agent",
    "git_author_email": "ai-agent@starvoxel.com",
    "git_token_env": "AI_GIT_TOKEN"
  },
  "secrets": {
    "run": ["bws", "run", "--project-id", "${BWS_PROJECT_ID}", "--"]
  }
}
