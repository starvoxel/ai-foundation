{
  "name": "ai-foundation",
  "version": "0.3.0",
  "private": true,
  "description": "Portable, harness-agnostic framework for AI-assisted software development",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "bin": {
    "aif": "./bin/aif.js",
    "ai-git": "./bin/ai-git.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test \"**/*.test.js\" --test-reporter spec",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:validation": "node --test \"tests/validation/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,md,yaml,yml}\"",
    "typecheck": "tsc --noEmit",
    "validate": "node bin/aif.js validate"
  },
  "dependencies": {
    "@googleapis/gmail": "22.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "google-auth-library": "11.3.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
